# Required: free Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.6-flash, with automatic fallback)
GEMINI_MODEL=

# Required in production: password to open the app
APP_PASSWORD=

# Token for /api/energy/sync (Garmin / Apple Health). Defaults to APP_PASSWORD.
INGEST_TOKEN=

# Production database (turso.tech). Leave empty locally to use ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
