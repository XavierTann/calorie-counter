# Required: free Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.6-flash, with automatic fallback)
GEMINI_MODEL=

# Required in production: long random string used to sign login cookies
# (generate one with: openssl rand -hex 32). Changing it logs everyone out.
AUTH_SECRET=

# Optional: if set, people need this code to create an account
INVITE_CODE=

# Production database (turso.tech). Leave empty locally to use ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
