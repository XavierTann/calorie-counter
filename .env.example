# Required: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Required in production: password to open the app
APP_PASSWORD=

# Token for /api/energy/sync (Garmin / Apple Health). Defaults to APP_PASSWORD.
INGEST_TOKEN=

# Production database (turso.tech). Leave empty locally to use ./local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
